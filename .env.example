# ============================================
# Pulso Cívico — Variables de entorno
# Copia este archivo como .env y ajusta valores locales.
# NUNCA subas tu .env al repositorio.
# ============================================

# development | production
APP_ENV=development

# --- Cliente HTTP de scrapers ---
HTTP_TIMEOUT=30
# Milisegundos entre peticiones (respeta los servidores de gobierno; mínimo recomendado 1000)
HTTP_RATE_LIMIT_MS=1250
# true en producción. En XAMPP/Windows sin CA bundle puede requerir false (solo local).
HTTP_VERIFY_SSL=false
# HTTP_USER_AGENT="PulsoCivicoBot/1.0 (+https://github.com/pulso-civico)"

# --- Herramientas y Auditoría ---
# Ruta opcional para el comando sync:paths
# PULSO_PATHS_SOURCE=

# --- Alertas y Tickets a Telegram (Opcional) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_TOPIC_ID=

