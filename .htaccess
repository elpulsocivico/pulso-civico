# ============================================================
# El Pulso de la Política — Apache Config
# SEO-optimized: Rewrite, Security, Performance & LLM
# ============================================================

# ── URL Rewriting ──
<IfModule mod_rewrite.c>
    RewriteEngine On

    # --- Seguridad: solo las fotos públicas de legisladores son accesibles dentro de storage/ ---
    RewriteRule ^storage/raw/photos/[^/]+\.(jpe?g|png|webp)$ - [NC,L]

    # --- Seguridad: bloquear carpetas internas (código, datos crudos, logs, herramientas) ---
    RewriteRule ^(storage|src|tools|bin|config|database|views|docs)(/|$) - [F,L]

    # --- Seguridad: bloquear archivos legacy ---
    RewriteRule ^index\.old\.php$ - [F,L]

    # Servir robots.txt, llms.txt y sitemap directamente sin pasar por PHP (si existen como archivos)
    RewriteRule ^robots\.txt$ - [L]
    RewriteRule ^llms\.txt$ - [L]
    RewriteRule ^llms-full\.txt$ - [L]
    RewriteRule ^security\.txt$ - [L]
    RewriteRule ^favicon\.ico$ - [L]
    RewriteRule ^site\.webmanifest$ - [L]

    # Si el archivo o directorio físico existe, servirlo directamente (ej. imágenes, assets)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Redirigir todas las rutas limpias al Front Controller index.php
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# ── Seguridad ──
# Ocultar dotfiles (.env, .git, .gitignore) y archivos de proyecto
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<FilesMatch "\.(md|sql|log|jsonl|ps1|sh|example)$">
    Require all denied
</FilesMatch>

# Evitar listado de directorios
Options -Indexes

# Headers de seguridad HTTP
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    # Eliminar firma del servidor
    Header unset Server
    Header unset X-Powered-By
</IfModule>

# ── Compresión GZIP ──
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml application/rss+xml
    AddOutputFilterByType DEFLATE image/svg+xml font/ttf font/woff font/woff2
</IfModule>

# ── Cache de Activos Estáticos (mejorar Core Web Vitals) ──
<IfModule mod_expires.c>
    ExpiresActive On

    # Imágenes
    ExpiresByType image/jpeg          "access plus 1 year"
    ExpiresByType image/png           "access plus 1 year"
    ExpiresByType image/webp          "access plus 1 year"
    ExpiresByType image/svg+xml       "access plus 1 month"
    ExpiresByType image/x-icon        "access plus 1 year"

    # Fuentes
    ExpiresByType font/ttf            "access plus 1 year"
    ExpiresByType font/woff           "access plus 1 year"
    ExpiresByType font/woff2          "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"

    # CSS / JS
    ExpiresByType text/css            "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript     "access plus 1 month"

    # HTML (sin caché agresivo — contenido dinámico)
    ExpiresByType text/html           "access plus 0 seconds"

    # XML / Sitemap / Feeds
    ExpiresByType application/xml     "access plus 1 hour"
    ExpiresByType text/xml            "access plus 1 hour"

    # JSON (robots.txt, llms.txt, manifiesto)
    ExpiresByType application/json    "access plus 1 hour"
    ExpiresByType text/plain          "access plus 1 day"
</IfModule>

# Cache-Control para activos estáticos con fingerprint
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2?|ttf|ico|png|jpg|jpeg|webp|svg)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(xml|txt)$">
        Header set Cache-Control "public, max-age=3600"
    </FilesMatch>
    <FilesMatch "\.php$">
        Header set Cache-Control "no-store, no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# ── MIME Types ──
<IfModule mod_mime.c>
    AddType application/manifest+json  .webmanifest
    AddType image/webp                 .webp
    AddType font/woff2                 .woff2
    AddType text/plain                 .txt
</IfModule>

# ── Charset por defecto ──
AddDefaultCharset UTF-8
