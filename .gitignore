# ============================================
# Pulso Cívico — .gitignore
# ============================================

# --- Secretos y entorno local ---
.env
.env.*
!.env.example
storage/raw/cookie.txt
*.cookie

# --- Datos crudos (se regeneran con los scrapers) ---
storage/raw/html/
storage/raw/*.txt
storage/raw/*.html
storage/raw/*.json
storage/raw/*.zip
storage/raw/*.pdf
storage/raw/*.xlsx
storage/raw/*.csv
storage/raw/*/
!storage/raw/photos/
!storage/raw/photos/**
dist/

# --- Python & ÁGORA Engine (solo local, no subir al repositorio de datos) ---
agora/
main.py
scripts/
archive/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
agora/.venv/

# --- Logs ---
storage/logs/*
!storage/logs/.gitkeep
*.log
*.jsonl

# --- Legacy / respaldos ---
index.old.php
*.bak
*.old
*.orig
*~

# --- Dependencias (si se agregan en el futuro) ---
/vendor/
/node_modules/

# --- IDE / SO ---
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# --- Caché de herramientas ---
.phpunit.cache/
.phpstan.cache/
