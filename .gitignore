# ============================================
# Pulso Cívico — .gitignore
# ============================================

# --- Secretos y entorno local ---
.env
.env.*
!.env.example
storage/raw/cookie.txt
*.cookie

# --- Datos crudos y Fotos (distribuidas externamente vía Drive/Mediafire) ---
storage/raw/html/
storage/raw/*.txt
storage/raw/*.html
storage/raw/*.zip
storage/raw/*.json
storage/raw/photos/*
!storage/raw/photos/.gitkeep

# --- Reportes locales y OSINT generados ---
storage/*.html
storage/*.pdf
storage/reporte_*

# --- Herramientas privadas y bots locales ---
tools/private/

# --- Logs ---
storage/logs/*
!storage/logs/.gitkeep
*.log
*.jsonl

# --- Legacy / respaldos ---
index.old.php
*.bak
*.old
*.orig
*~

# --- Dependencias (si se agregan en el futuro) ---
/vendor/
/node_modules/

# --- IDE / SO ---
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# --- Caché de herramientas y aplicación ---
.phpunit.cache/
.phpstan.cache/
storage/cache/*
!storage/cache/.gitkeep

# --- Python y entorno virtual ---
.venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
storage/electoral/actas/*
!storage/electoral/actas/.gitkeep
tor_keys/

# --- Módulos en desarrollo / scrapers y datos experimentales ---
storage/data/adquisiciones/
storage/data/declaraciones/
storage/data/veracruz/
storage/raw/adquisiciones/
tools/scrapers/
tools/sync_facebook_to_sheets.py
app/services/declaraciones_service.py
docs/CONTEXTO_MONITOR_POLITICO_BC.md
